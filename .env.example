# Local dev defaults: mock mode, no remote calls.
#
# Copy to `.env` and edit for your environment.
#
# When pointing at the MI300X droplet, use the Tailscale IP, not the
# public DigitalOcean IP — the SSH MITM described in docs/ROCM_FEEDBACK.md
# affects port 8000 too. Run `tailscale ip -4 atls-droplet` to look it up,
# or check `tailscale status`. Example: VLLM_BASE_URL=http://100.116.60.54:8000/v1
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=Qwen/Qwen2.5-VL-72B-Instruct
EMBED_MODEL=BAAI/bge-m3
DEFAULT_LANG=en
MOCK_MODE=true
